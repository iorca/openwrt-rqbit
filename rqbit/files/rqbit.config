# SPDX-License-Identifier: Apache-2.0
# rqbit UCI configuration
#
# /etc/init.d/rqbit restart  applies changes.

config rqbit 'main'
	option enabled '1'

	# Where downloaded data lands. Must exist on a writable filesystem with
	# enough space - the rqbit binary itself is ~26 MB, torrents are not.
	option download_dir '/mnt/data/rqbit'

	# HTTP API + built-in web UI. Bind to 0.0.0.0 to reach it from the LAN,
	# or 127.0.0.1:3030 to keep it router-only.
	# Web UI: http://<router-ip>:3030/web/
	option api_listen '0.0.0.0:3030'

	# BitTorrent peer listen port (TCP, plus uTP if enabled upstream).
	option listen_port '4240'

	# Session state (session.json + .torrent + .bitv files).
	# Empty means "<download_dir>/.session".
	option persistence_dir ''

	# Drop .torrent files here to auto-add them. Empty disables the watcher.
	option watch_dir ''

	# Allow adding torrents through the HTTP API / web UI.
	option allow_create '1'

	# HTTP basic auth for the API and web UI. Empty user disables auth.
	# The password is stored in plaintext in /etc/config/rqbit - keep the API
	# bound to LAN only if you skip this.
	option auth_user ''
	option auth_pass ''

	# rqbit defaults to trying UPnP port forwarding. On a router this is
	# pointless at best and opens the peer port to the WAN at worst.
	option disable_upnp '1'

	# Local peer discovery (LSD) announces torrents on the LAN.
	option disable_lsd '0'

	# Force IPv4-only peer/tracker traffic. Useful on CGNAT or broken IPv6.
	option ipv4_only '0'

	# Rate limits in bytes/sec. Empty means unlimited.
	option ratelimit_download ''
	option ratelimit_upload ''

	# Max connected peers per torrent. Empty uses the upstream default.
	option peer_limit ''

	# Blocking thread pool size for disk I/O. Empty uses the upstream default
	# of 8. ipq6000 has 4 cores, 4-8 is sane.
	option worker_threads ''

	# Optional: newline-delimited "name:start_ip-end_ip" blocklist URL.
	option blocklist_url ''

	# Optional: file with one tracker URL per line, added to every torrent.
	option trackers_file ''

	# trace | debug | info | warn | error
	option log_level 'info'

	# Optional clean log file (no ANSI escapes). Empty disables it.
	option log_file ''

	# Raw extra CLI arguments, appended last. Use with care.
	option extra_args ''
